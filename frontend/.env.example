# Copy to .env.local and adjust for local development.
# Empty VITE_API_BASE_URL means: use the Vite dev proxy (127.0.0.1:8000).
VITE_API_BASE_URL=

# For production builds (Firebase Hosting / Android APK), point at the
# deployed Django backend on Render:
# VITE_API_BASE_URL=https://foodflow-api.onrender.com
