# Copy to backend/.env (local) or paste into Render dashboard env vars.
# Local dev with no keys = DEMO payment mode (payments are simulated).

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
# Comma separated, e.g. https://foodflow.web.app,https://your-custom-domain
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional: external Postgres. Falls back to SQLite when unset.
# DATABASE_URL=postgres://user:password@host:5432/foodflow

# Razorpay (https://dashboard.razorpay.com/app/keys)
# Leave blank for demo mode. Use TEST keys first, then live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
